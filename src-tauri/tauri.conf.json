{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boto Studio",
  "version": "0.1.0",
  "identifier": "com.boto.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boto Studio",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
